# 复制成 .env 后填值。.env 已被 .gitignore 排除。
# 本地开发可以直接跑：node tools/gen-env.mjs  从 supabase/.env.local 生成

# 后端入口。将来上反代时只改这一行，代码不动。
VITE_SB_URL=https://xxxxxxxx.supabase.co

# publishable key（sb_publishable_...），设计上就是给前端用的公开密钥。
# 千万不要在这里放 sb_secret_... / service_role
VITE_SB_ANON_KEY=sb_publishable_xxxxxxxx

# 示范家庭邀请码，正式建家后改掉或留空
VITE_DEMO_INVITE=DEMO01
